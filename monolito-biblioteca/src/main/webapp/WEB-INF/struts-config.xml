<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE struts-config PUBLIC 
    "-//Apache Software Foundation//DTD Struts Configuration 1.3//EN"
    "http://struts.apache.org/dtds/struts-config_1_3.dtd">

<struts-config>
    <action-mappings>
        <!-- LivroAction (DispatchAction) -->
        <action path="/livro" 
                type="tcc.legado.action.LivroAction"
                scope="request"
                parameter="metodo">  
            
            <forward name="listarSucesso" path="/lista-livros.jsp"/>
            <forward name="novo" path="/cadastro-livro.jsp"/>
            <forward name="editar" path="/cadastro-livro.jsp"/>
            <forward name="erro" path="/erro.jsp"/>
        </action>
        
        <!-- (Em breve: UsuarioAction, EmprestimoAction, DevolucaoAction) -->
    </action-mappings>
    
</struts-config>
