<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE struts-config PUBLIC 
"-//Apache Software Foundation//DTD Struts Configuration 1.3//EN"
"http://struts.apache.org/dtds/struts-config_1_3.dtd">

<struts-config>
    <action-mappings>
        <!-- LivroAction (DispatchAction) -->
        <action path="/livro" 
            type="tcc.legado.action.LivroAction"
            scope="request"
            parameter="metodo">  

            <forward name="listarSucesso" path="/WEB-INF/views/livro/lista-livros.jsp"/>
            <forward name="novo" path="/WEB-INF/views/livro/cadastro-livro.jsp"/>
            <forward name="voltar" path="/WEB-INF/views/index.jsp"/>
            <forward name="editar" path="/WEB-INF/views/livro/cadastro-livro.jsp"/>
            <forward name="erro" path="/error.jsp"/>
            <forward name="detalhar" path="/WEB-INF/views/livro/detalhe-livro.jsp"/>
        </action>
        <action path="/usuario" 
            type="tcc.legado.action.UsuarioAction"
            scope="request"
            parameter="metodo">
            <forward name="listarSucesso" path="/WEB-INF/views/usuario/lista-usuarios.jsp"/>
            <forward name="novo" path="/WEB-INF/views/usuario/cadastro-usuario.jsp"/>
            <forward name="editar" path="/WEB-INF/views/usuario/cadastro-usuario.jsp"/>
            <forward name="erro" path="/error.jsp"/>
            <forward name="voltar" path="/WEB-INF/views/index.jsp"/>
        </action>
        <action path="/auth" 
        type="tcc.legado.action.AuthAction"
        scope="request"
        parameter="metodo">
            <forward name="sucesso" path="/WEB-INF/views/index.jsp"/>
            <forward name="erro" path="/login.jsp"/>
            <forward name="logout" path="/login.jsp"/>
        </action>
        <action path="/emprestimo" 
        type="tcc.legado.action.EmprestimoAction"
        scope="request"
        parameter="metodo">
        <forward name="novo" path="/WEB-INF/views/emprestimo/emprestimo.jsp"/>
            <forward name="listarSucesso" path="/WEB-INF/views/emprestimo/lista-emprestimos.jsp"/>
            <forward name="devolver" path="/WEB-INF/views/emprestimo/devolucao.jsp"/>
            <forward name="erro" path="/error.jsp"/>
            <forward name="voltar" path="/WEB-INF/views/index.jsp"/>
            <forward name="detalhar" path="/WEB-INF/views/emprestimo/detalhe-emprestimo.jsp"/>
    </action>
        <action path="/destaque"
            type="tcc.legado.action.LivroDestaqueAction"
            scope="request"
            parameter="metodo">
            <forward name="listarSucesso" path="/WEB-INF/views/destaque/lista-destaques.jsp"/>
            <forward name="novo" path="/WEB-INF/views/destaque/cadastro-destaque.jsp"/>
            <forward name="editar" path="/WEB-INF/views/destaque/cadastro-destaque.jsp"/>
            <forward name="visualizar" path="/WEB-INF/views/destaque/lista-destaques.jsp"/>
            <forward name="erro" path="/error.jsp"/>
            <forward name="voltar" path="/WEB-INF/views/index.jsp"/>
            <forward name="visualizar" path="/WEB-INF/views/destaque/detalhe-destaque.jsp"/>
        </action>
    </action-mappings>

</struts-config>