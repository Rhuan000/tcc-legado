<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE struts-config PUBLIC 
"-//Apache Software Foundation//DTD Struts Configuration 1.3//EN"
"http://struts.apache.org/dtds/struts-config_1_3.dtd">

<struts-config>
    <action-mappings>
        <!-- LivroAction (DispatchAction) -->
        <action path="/livro" 
            type="tcc.legado.action.LivroAction"
            scope="request"
            parameter="metodo">  

            <forward name="listarSucesso" path="/livro/lista-livros.jsp"/>
            <forward name="novo" path="/livro/cadastro-livro.jsp"/>
            <forward name="editar" path="/livro/cadastro-livro.jsp"/>
            <forward name="erro" path="/erro.jsp"/>
        </action>
        <action path="/usuario" 
            type="tcc.legado.action.UsuarioAction"
            scope="request"
            parameter="metodo">
            <forward name="listarSucesso" path="/usuario/lista-usuarios.jsp"/>
            <forward name="novo" path="/usuario/cadastro-usuario.jsp"/>
            <forward name="editar" path="/usuario/cadastro-usuario.jsp"/>
            <forward name="erro" path="/erro.jsp"/>
        </action>
        <action path="/auth" 
        type="tcc.legado.action.AuthAction"
        scope="request"
        parameter="metodo">
            <forward name="sucesso" path="/index.jsp"/>
            <forward name="erro" path="/login.jsp"/>
            <forward name="logout" path="/login.jsp"/>
        </action>
        <action path="/emprestimo" 
        type="tcc.legado.action.EmprestimoAction"
        scope="request"
        parameter="metodo">
        <forward name="novo" path="/emprestimo/emprestimo.jsp"/>
            <forward name="listarSucesso" path="/emprestimo/lista-emprestimos.jsp"/>
            <forward name="devolver" path="/emprestimo/devolucao.jsp"/>
            <forward name="erro" path="/erro.jsp"/>
    </action>
    </action-mappings>

</struts-config>
